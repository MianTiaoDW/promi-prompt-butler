{
  "name": "prompt-butler-extension",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "native:install": "powershell -ExecutionPolicy Bypass -File scripts/install-native-host.ps1",
    "native:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-native-host.ps1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "framer-motion": "^12.10.5",
    "lucide-react": "^0.511.0",
    "matter-js": "^0.20.0",
    "motion": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-rnd": "^10.5.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.314",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
